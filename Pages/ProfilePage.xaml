<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClubNegociosUDLA.Pages.ProfilePage"
             Title="Perfil"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="18,16" Spacing="16" MaximumWidthRequest="880" HorizontalOptions="Center">
            <!-- Tarjeta de usuario -->
            <Border BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" Padding="18">
                <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" WidthRequest="56" HeightRequest="56">
                        <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                        <Image Source="logo_club.png" HeightRequest="36" WidthRequest="36" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label x:Name="UserNameLabel" Text="Santiago Viteri" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label x:Name="UserEmailLabel" Text="santiago.viteri.alcivar@udla.edu.ec" FontSize="12" TextColor="{StaticResource TextMuted}" />
                        <Label x:Name="UserRoleLabel" Text="Desarrollador · Admin TI" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="Salir"
                            Clicked="OnLogoutClicked"
                            BackgroundColor="#FEE2E2"
                            TextColor="#B91C1C"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Leaderboard de Miembros -->
            <Label Text="🏆 Ranking de Participación (XP y Horas)" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
            <VerticalStackLayout x:Name="LeaderboardLayout" Spacing="8" />

            <!-- Estado SQLite + Equipo -->
            <Border BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="💾 Persistencia Local SQLite" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                    <Label x:Name="DbPathLabel" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" Margin="0,6" />
                    <Label Text="👥 Equipo Desarrollador (Progreso 2 · UDLA)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Label Text="Justin Frutos · Xavier Rojas · Juan Marcos Vallejo · Anderson Calderón · Santiago Viteri"
                           FontSize="13"
                           TextColor="{StaticResource TextMain}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
