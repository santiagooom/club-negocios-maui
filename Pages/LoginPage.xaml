<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClubNegociosUDLA.Pages.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="18" MaximumWidthRequest="480" HorizontalOptions="Center">
            <!-- Cabecera visual UDLA Park -->
            <Border StrokeThickness="0" BackgroundColor="#82091E" HeightRequest="150">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Grid>
                    <Image Source="udlapark.jpg" Aspect="AspectFill" Opacity="0.35" />
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="16">
                        <Border BackgroundColor="White" StrokeThickness="0" Padding="14,8" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="12">
                                <Image Source="logo_udla.png" HeightRequest="28" Aspect="AspectFit" />
                                <Image Source="logo_club.png" HeightRequest="30" Aspect="AspectFit" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label Text="Club de Negocios Digitales · UDLA"
                               TextColor="White"
                               FontSize="19"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Tarjeta de Login -->
            <Border BackgroundColor="White" Stroke="{StaticResource BorderSubtle}" StrokeThickness="1" Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Iniciar Sesión"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}" />
                    <Label Text="Ingresa con tu correo institucional @udla.edu.ec para gestionar actividades, eventos y horas."
                           FontSize="13"
                           TextColor="{StaticResource TextMuted}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo institucional" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Border BackgroundColor="{StaticResource CardSubtle}" Stroke="{StaticResource BorderSubtle}" Padding="10,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Entry x:Name="EmailEntry"
                                   Placeholder="nombre.apellido@udla.edu.ec"
                                   Keyboard="Email"
                                   TextColor="{StaticResource TextMain}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                        <Border BackgroundColor="{StaticResource CardSubtle}" Stroke="{StaticResource BorderSubtle}" Padding="10,4">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Contraseña"
                                   IsPassword="True"
                                   TextColor="{StaticResource TextMain}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="ErrorLabel"
                           IsVisible="False"
                           TextColor="#DC2626"
                           FontSize="13" />

                    <Button x:Name="LoginButton"
                            Text="Ingresar a la Plataforma"
                            Clicked="OnLoginClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" Margin="0,4" />

                    <Label Text="Acceso rápido de demostración (clave demo: udla2027):"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Admin (Santiago)"
                                Clicked="OnDemoAdminClicked"
                                BackgroundColor="{StaticResource PrimarySoft}"
                                TextColor="{StaticResource Primary}"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="10" />
                        <Button Grid.Column="1"
                                Text="Coord. (Justin)"
                                Clicked="OnDemoCoordClicked"
                                BackgroundColor="{StaticResource ClubCyanSoft}"
                                TextColor="{StaticResource ClubCyan}"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="10" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Desarrollado en .NET MAUI + SQLite · Periodo 2027-10"
                   FontSize="12"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
